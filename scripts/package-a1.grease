#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) < 4 or len(ARGV) > 4) {
  echo 'usage: package-a1.grease ANDROID_NDK_REPOSITORY NATIVE_LIBRARY OUTPUT_APK SOURCE_REVISION'
  exit 2
}
var packaging_repository = ARGV[0]
var native_library = ARGV[1]
var output = ARGV[2]
var revision = ARGV[3]
var script_directory = $(dirname "$0")
var repository = $(realpath "$script_directory/..")
var packaging_pin = $(git -C "$packaging_repository" rev-parse HEAD)
test "$packaging_pin" = 7c61ee43e75f7c2dab9288edb0e10055898b36e6
# The packager validates every explicit identity/signer input, then verifies
# the finished APK certificate, manifest, launcher, native payload and no DEX.
ANDROID_SOURCE_COMMIT="$revision" \
  bash "$packaging_repository/apk/build-nativeactivity-apk.sh" \
    "$repository/android/AndroidManifest.xml" "$native_library" armeabi-v7a "$output"
wc -c "$output"
