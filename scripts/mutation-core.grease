#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) < 4) { echo 'usage: mutation-core.grease ICK ICK_LIBEXEC LUA OUTPUT [host options...]'; exit 2 }
var directory = $(dirname "$0")
var repository = $(realpath "$directory/..")
var output = ARGV[3]
var compiler = ARGV[0]
var support = ARGV[1]
var lua = ARGV[2]
var options = ARGV[4:]
mkdir -p "$output"
# The parent invokes the verified Grease runtime; preserve it across child recipes.
var runtime = ENV.FC_GREASE
proc qualify(name, expression, diagnostic) {
  var mutant = "$output/$name"
  mkdir -p "$mutant"
  cp -a "$repository/src" "$repository/scripts" "$repository/tests" "$repository/third-party" "$repository/policy" "$repository/transport" "$mutant/"
  sed "$expression" "$repository/src/conversation.c" > "$mutant/src/conversation.c"
  "$runtime" "$mutant/scripts/test-core.grease" "$compiler" "$support" "$lua" "$mutant/test" @options > "$mutant/build.log" 2>&1
  if "$mutant/test" > "$mutant/result.log" 2>&1 { echo "FAIL surviving mutation $name"; exit 1 }
  rg -Fq "$diagnostic" "$mutant/result.log"
  echo "PASS rejected $name: $diagnostic"
}
qualify retry 's/if (publish_record(conversation, event,/if (event != RETRY \&\& publish_record(conversation, event,/' 'FAIL missing canonical retry_requested before transport_attempt_submitted'
qualify response-fsync 's/if (durability_barrier(conversation, conversation->response) != FC_OK) return FC_STORAGE_ERROR;/\/\* mutation: omitted response barrier \*\//' 'conversation.extents.durable == (stage ? 22u : 0u)'
qualify response-crc 's/if (checksum != expected) return FC_CORRUPT;/(void)expected;/' 'conversation_open(&conversation, path) == FC_CORRUPT'
