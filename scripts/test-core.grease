#!/usr/bin/env grease
# Host producer qualification; Android has a separate declared producer lane.
set -eu -o pipefail
if (len(ARGV) < 9) {
  echo 'usage: test-core.grease ICK_DRIVER ICK_LIBEXEC ICKY_LUA_SOURCE OUTPUT FP_CHECKOUT GREASE STOCK_LUA_SOURCE RUNTIME_ICK_DRIVER RUNTIME_ICK_LIBEXEC [host options...]'
  exit 2
}
var compiler = ARGV[0]
var support = ARGV[1]
var lua = ARGV[2]
var output = ARGV[3]
var fp = ARGV[4]
var grease = ARGV[5]
var stock = ARGV[6]
var runtime_compiler = ARGV[7]
var runtime_support = ARGV[8]
var flags = ARGV[9:]
var script_directory = $(dirname "$0")
var repository = $(realpath "$script_directory/..")
test ! -e "$output.runtime"
mkdir -p "$output.runtime"
var receipt = "$output.runtime/consumer.tsv"
printf 'key\tvalue\nphysical_device\tNOT_RUN\nandroid_build\tNOT_RUN\n' > "$receipt"
proc blocked (code) {
  printf 'status\tBLOCKED\nblocker\t%s\n' "$code" >> "$receipt"
  echo "BLOCKED $code" >&2
  exit 1
}
var fp_revision = $(git -C "$fp" rev-parse HEAD)
if ! test "$fp_revision" = 5caaba31256bfb424638f8a3d4d554c56fa9a970 { blocked wrong_shared_qualifier_revision }
var fp_status = $(git -C "$fp" status --porcelain)
if ! test -z "$fp_status" { blocked modified_shared_qualifier }
var stock_revision = $(git -C "$stock" rev-parse HEAD)
if ! test "$stock_revision" = 0b29f408433e92953cc72b1d3e06c7ac8139e439 { blocked wrong_stock_control_revision }
var stock_status = $(git -C "$stock" status --porcelain)
if ! test -z "$stock_status" { blocked modified_stock_control }
printf 'shared_qualifier\t%s\nconsumer_revision\t%s\n' "$fp_revision" "$(git -C "$repository" rev-parse HEAD)" >> "$receipt"
git -C "$repository" diff HEAD -- src tests policy scripts/test-core.grease > "$output.runtime/consumer-source.diff"
var policy = "$repository/policy/composition.lua"
var policy_before = $(sha256sum "$policy")
if ! "$grease" "$fp/scripts/qualify-icky-lua.grease" "$lua" "$runtime_compiler" "$runtime_support" "$output.runtime/qualified" { blocked shared_runtime_gate_failed }
var runtime_object = "$output.runtime/qualified/icky-lua.o"
var object_before = $(sha256sum "$runtime_object")
printf 'linked_runtime_before\t%s\npolicy_source_before\t%s\n' "$object_before" "$policy_before" >> "$receipt"
# The same object that executed the full glyph fixture is the consumer input.
var host_flags = ["-B$support/", '-fno-use-linker-plugin', '-std=c11', '-D_FILE_OFFSET_BITS=64', '-O2', '-Wall', '-Wextra', '-Werror', "-I$repository/src", "-I$repository/third-party/appendfat-arena", "-I$lua", "-DFC_POLICY_SOURCE=\"$policy\"", '-ffunction-sections', '-fdata-sections']
var sources = ["$repository/src/conversation.c", "$repository/src/render_policy.c", "$repository/src/fixture_transport.c", "$repository/third-party/appendfat-arena/appendfat_arena.c", "$repository/tests/conversation.c"]
var link_flags = ['-Wl,--gc-sections', '-Wl,--unique=.rodata.fastchat_policy', '-lm', '-ldl']
if ! "$compiler" @host_flags @flags @sources "$runtime_object" @link_flags -o "$output" > "$output.runtime/consumer-build.stdout" 2> "$output.runtime/consumer-build.stderr" { blocked consumer_build_failed }
var object_after = $(sha256sum "$runtime_object")
if ! test "$object_before" = "$object_after" { blocked runtime_changed_across_consumer_link }
var policy_after = $(sha256sum "$policy")
if ! test "$policy_before" = "$policy_after" { blocked policy_changed_across_consumer_link }
objcopy --dump-section .rodata.fastchat_policy="$output.runtime/embedded-policy.lua" "$output"
if ! cmp "$policy" "$output.runtime/embedded-policy.lua" { blocked substituted_consumer_policy_bytes }
readelf -d "$output" > "$output.runtime/linked-libraries.txt"
if rg -iq 'NEEDED.*lua' "$output.runtime/linked-libraries.txt" { blocked unexpected_dynamic_lua_library }
if ! "$output" > "$output.runtime/suite.stdout" 2> "$output.runtime/suite.stderr" { blocked consumer_suite_failed }
# Counterfactual: same consumer/raw policy, actual same-version stock object.
"$compiler" @host_flags @flags -DMAKE_LIB -DLUA_USE_POSIX "-I$stock" -c "$stock/onelua.c" -o "$output.runtime/stock-lua.o"
"$compiler" @host_flags @flags @sources "$output.runtime/stock-lua.o" @link_flags -o "$output.runtime/stock-consumer"
if "$output.runtime/stock-consumer" benchmark ram unused > "$output.runtime/stock-consumer.stdout" 2> "$output.runtime/stock-consumer.stderr" {
  blocked stock_linked_consumer_admitted
}
if ! rg -q 'policy_open\(\) == FC_OK' "$output.runtime/stock-consumer.stderr" { blocked stock_consumer_failed_for_unrelated_reason }
printf 'linked_runtime_after\t%s\nconsumer_executable\t%s\nembedded_policy\t%s\nstock_runtime_object\t%s\nstock_consumer_executable\t%s\n' "$object_after" "$(sha256sum "$output")" "$(sha256sum "$output.runtime/embedded-policy.lua")" "$(sha256sum "$output.runtime/stock-lua.o")" "$(sha256sum "$output.runtime/stock-consumer")" >> "$receipt"
printf 'shared_runtime_semantics\tPASS\nconsumer_suite\tPASS\nconsumer_policy_bytes\tPASS\nstock_linked_consumer_rejected\tPASS\nstatus\tPASS\n' >> "$receipt"
cat "$output.runtime/suite.stdout"
echo 'PASS actual FastChat consumer, checked static runtime, raw policy and stock-object rejection'
