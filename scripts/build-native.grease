#!/usr/bin/env grease
# Producer only. Compilation and platform linking are separate named stages.
set -eu -o pipefail
if (len(ARGV) < 6 or len(ARGV) > 7) {
  echo 'usage: build-native.grease ICK_DRIVER ICK_LIBEXEC NDK ICKY_LUA_SOURCE OUTPUT_DIRECTORY HTTP2_PREFIX [ABI]'
  exit 2
}
var compiler = ARGV[0]
var support = ARGV[1]
var ndk = ARGV[2]
var lua = ARGV[3]
var output = ARGV[4]
var http2 = ARGV[5]
var abi = 'armeabi-v7a'
if (len(ARGV) === 7) { setvar abi = ARGV[6] }
var gnu_target = 'arm-linux-gnueabi'
var header_target = 'arm-linux-androideabi'
var runtime_arch = 'arm'
var elf_class = 'ELF32'
var elf_machine = 'ARM'
var target_flags = ['-marm', '-march=armv7-a', '-mfloat-abi=softfp', '-mfpu=vfpv3-d16']
if (abi === 'arm64-v8a') {
  setvar gnu_target = 'aarch64-linux-gnu'
  setvar header_target = 'aarch64-linux-android'
  setvar runtime_arch = 'aarch64'
  setvar elf_class = 'ELF64'
  setvar elf_machine = 'AArch64'
  setvar target_flags = ['-ffixed-x18']
} else {
  test "$abi" = armeabi-v7a
}
var directory = $(dirname "$0")
var repository = $(realpath "$directory/..")
var host = "$ndk/toolchains/llvm/prebuilt/linux-x86_64"
var sysroot = "$host/sysroot"
var builtin = $("$compiler" "-B$support/" -print-file-name=include)
test -f "$builtin/stdatomic.h"
test -f "$builtin/stddef.h"
var machine = $("$compiler" -dumpmachine)
test "$machine" = "$gnu_target"
var identity = $("$compiler" --version)
echo "$identity" | rg -q '\(GCC\)'
var revision = $(git -C "$repository" rev-parse HEAD)
git -C "$repository" diff --quiet HEAD -- src android policy transport/native scripts third-party
var lua_revision = $(git -C "$lua" rev-parse HEAD)
test "$lua_revision" = 87306483cec50f8c750a22dda1d0742246fad756
git -C "$lua" diff --quiet HEAD -- '*.c' '*.h'
mkdir -p "$output"
var flags = ['-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', '-fPIC', '-fvisibility=hidden', '-ffunction-sections', '-fdata-sections', '-D_FILE_OFFSET_BITS=64', '-D__ANDROID__', '-D__ANDROID_API__=26', '-D__ANDROID_MIN_SDK_VERSION__=26', '-DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD'] ++ target_flags
for source in (['conversation', 'render_policy', 'fixture_transport', 'provider', 'transport_boundary', 'settings']) {
  "$compiler" "-B$support/" "--sysroot=$sysroot" -nostdinc -isystem "$builtin" -isystem "$sysroot/usr/include" \
    -isystem "$sysroot/usr/include/$header_target" "-I$repository/src" \
    "-I$repository/third-party/appendfat-arena" "-I$lua" "-I$repository/transport/native" \
    "-DFC_POLICY_SOURCE=\"$repository/policy/composition.lua\"" @flags \
    -c "$repository/src/$source.c" -o "$output/$source.o"
}
for source in (['curl_transport', 'sse', 'provider_framing']) {
  "$compiler" "-B$support/" "--sysroot=$sysroot" -nostdinc -isystem "$builtin" -isystem "$sysroot/usr/include" \
    -isystem "$sysroot/usr/include/$header_target" "-I$http2/include" @flags \
    -c "$repository/transport/native/$source.c" -o "$output/$source.o"
}
"$compiler" "-B$support/" "--sysroot=$sysroot" -nostdinc -isystem "$builtin" -isystem "$sysroot/usr/include" \
  -isystem "$sysroot/usr/include/$header_target" "-I$repository/third-party/appendfat-arena" @flags \
  -c "$repository/third-party/appendfat-arena/appendfat_arena.c" -o "$output/appendfat_arena.o"
"$compiler" "-B$support/" "--sysroot=$sysroot" -nostdinc -isystem "$builtin" -isystem "$sysroot/usr/include" \
  -isystem "$sysroot/usr/include/$header_target" "-I$lua" @flags \
  -DMAKE_LIB -DLUA_USE_POSIX -c "$lua/onelua.c" -o "$output/icky-lua.o"
"$compiler" "-B$support/" "--sysroot=$sysroot" -nostdinc -isystem "$builtin" -isystem "$sysroot/usr/include" \
  -isystem "$sysroot/usr/include/$header_target" "-I$repository/src" @flags \
  "-DFC_SOURCE_REVISION=\"$revision\"" \
  -c "$repository/android/native_activity.c" -o "$output/native_activity.o"
# ICK supplies every first-party C object. NDK supplies Bionic CRT, link editor,
# platform stubs and the ARM helper runtime; there is no Clang C compilation.
"$host/bin/ld.lld" -shared -soname libfastchat.so --no-undefined --hash-style=both --gc-sections \
  -z relro -z now -z max-page-size=16384 \
  "$sysroot/usr/lib/$header_target/26/crtbegin_so.o" \
  "$output/conversation.o" "$output/render_policy.o" "$output/fixture_transport.o" "$output/provider.o" "$output/transport_boundary.o" "$output/settings.o" "$output/appendfat_arena.o" "$output/native_activity.o" "$output/icky-lua.o" \
  "$output/curl_transport.o" "$output/sse.o" "$output/provider_framing.o" \
  "$http2/lib/libcurl.a" "$http2/lib/libnghttp2.a" "$http2/lib/libssl.a" "$http2/lib/libcrypto.a" \
  "-L$sysroot/usr/lib/$header_target/26" "-L$sysroot/usr/lib/$header_target" \
  -landroid -llog -lc -lm -ldl "$host/lib/clang/21/lib/linux/libclang_rt.builtins-$runtime_arch-android.a" \
  "$sysroot/usr/lib/$header_target/26/crtend_so.o" -o "$output/libfastchat.debug.so"
cp "$output/libfastchat.debug.so" "$output/libfastchat.so"
"$host/bin/llvm-strip" --strip-unneeded "$output/libfastchat.so"
"$host/bin/llvm-readelf" -h -A -d -s "$output/libfastchat.so" > "$output/native-abi.txt"
rg -q "Class:.*$elf_class" "$output/native-abi.txt"
rg -q "Machine:.*$elf_machine" "$output/native-abi.txt"
rg -q 'ANativeActivity_onCreate' "$output/native-abi.txt"
if rg -Uq 'TagName: ABI_VFP_args\s+Description: VFP registers' "$output/native-abi.txt" {
  echo 'FAIL hard-float calling convention'
  exit 1
}
sha256sum "$compiler" "$support/cc1" "$support/as" "$host/bin/ld.lld" \
  "$host/lib/clang/21/lib/linux/libclang_rt.builtins-$runtime_arch-android.a" "$output/libfastchat.so" > "$output/native-digests.txt"
"$host/bin/ld.lld" --version > "$output/linker-identity.txt"
"$support/as" --version > "$output/assembler-identity.txt"
printf '%s\t%s\n' source_commit "$revision" > "$output/source-binding.tsv"
printf '%s\t%s\n' icky_lua_commit "$lua_revision" >> "$output/source-binding.tsv"
printf '%s\t%s\n' abi "$abi" >> "$output/source-binding.tsv"
wc -c "$output/libfastchat.debug.so" "$output/libfastchat.so" > "$output/native-sizes.txt"
echo 'PASS ICK C objects, NDK platform link, stripped native library (runtime not run)'
