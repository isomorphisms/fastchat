module FastChatCoreTests

import FastChatCore

two_requests_test : Bool
two_requests_test =
  let initial =
        empty_core
          (authority 1)
          (conversation 1)
  in case submit_request "first" initial of
    submitted_request after_first first_request first_attempt first_outbound ⇒
      case submit_request "second" after_first of
        submitted_request after_second second_request second_attempt second_outbound ⇒
          let interleaved =
                [ started_for first_outbound
                , started_for second_outbound
                , chunk_for first_outbound "first answer"
                , chunk_for second_outbound "second answer"
                , completed_for second_outbound
                , completed_for first_outbound
                ]
              finished =
                run_transport_events interleaved after_second
          in not (same_request first_request second_request) &&
             not (same_attempt first_attempt second_attempt) &&
             request_is_completed first_request finished &&
             request_is_completed second_request finished &&
             log_size finished ≟ 10

independent_views_test : Bool
independent_views_test =
  let conversation_key = conversation 2
      initial =
        empty_core
          (authority 1)
          conversation_key
  in case submit_request "one shared history" initial of
    submitted_request after_submit request_key attempt_key outbound ⇒
      let finished =
            run_transport_events
              (simulate_success outbound)
              after_submit
          first_view = open_view (view 1) conversation_key
          second_view = open_view (view 2) conversation_key
      in case read_view first_view (core_log finished) of
        observed advanced_first first_events ⇒
          case read_view advanced_first (core_log finished) of
            observed _ repeated_first_events ⇒
              case read_view second_view (core_log finished) of
                observed _ second_events ⇒
                  event_count first_events ≟ 5 &&
                  event_count repeated_first_events ≟ 0 &&
                  event_count second_events ≟ 5

completion_wins_cancellation_race_test : Bool
completion_wins_cancellation_race_test =
  let initial =
        empty_core
          (authority 1)
          (conversation 3)
  in case submit_request "race" initial of
    submitted_request after_submit request_key attempt_key outbound ⇒
      let started =
            handle_model_event
              (started_for outbound)
              after_submit
          cancellation_requested_core =
            request_cancellation
              request_key
              started
          completed =
            handle_model_event
              (completed_for outbound)
              cancellation_requested_core
          late_cancel =
            handle_model_event
              (cancelled_for outbound)
              completed
      in request_is_completed request_key late_cancel &&
         log_size late_cancel ≟ 5 &&
         diagnostic_count late_cancel ≟ 1

uncertain_delivery_requires_explicit_retry_test : Bool
uncertain_delivery_requires_explicit_retry_test =
  let initial =
        empty_core
          (authority 1)
          (conversation 4)
  in case submit_request "uncertain" initial of
    submitted_request after_submit request_key old_attempt old_outbound ⇒
      let uncertain =
            run_transport_events
              (simulate_loss_after_chunk old_outbound)
              after_submit
      in if not (request_is_uncertain request_key uncertain)
           then False
           else case retry_request request_key uncertain of
             retry_rejected _ _ ⇒ False
             retry_started after_retry new_attempt new_outbound ⇒
               let with_stale_observation =
                     handle_model_event
                       (chunk_for old_outbound "late stale bytes")
                       after_retry
                   finished =
                     run_transport_events
                       (simulate_success new_outbound)
                       with_stale_observation
               in not (same_attempt old_attempt new_attempt) &&
                  request_is_completed request_key finished &&
                  request_attempt_is request_key new_attempt finished &&
                  log_size finished ≟ 10 &&
                  diagnostic_count finished ≟ 1

typed_command_boundary_test : Bool
typed_command_boundary_test =
  let initial =
        empty_core
          (authority 9)
          (conversation 9)
  in case apply_user_command (send_text "boundary") initial of
    core_effects after_send
      [start_model outbound@(send_to _ _ request_key attempt_key _)] ⇒
        case apply_user_command (cancel request_key) after_send of
          core_effects after_cancel
            [cancel_model_attempt cancelled_request cancelled_attempt] ⇒
              same_request request_key cancelled_request &&
              same_attempt attempt_key cancelled_attempt &&
              log_size after_cancel ≟ 3
          _ ⇒ False
    _ ⇒ False

retry_event_order_test : Bool
retry_event_order_test =
  case submit_request "retry order" (empty_core (authority 1) (conversation 1)) of
    submitted_request sent request_key old_attempt outbound ⇒
      let lost = run_transport_events (simulate_loss_after_chunk outbound) sent in
      case retry_request request_key lost of
        retry_rejected _ _ ⇒ False
        retry_started retried fresh_attempt _ ⇒
          case read_log (after_sequence 5) (core_log retried) of
            read_events _
              [ stored 6 (retry_requested retry_key)
              , stored 7 (transport_attempt_submitted transport_key submitted_attempt)
              ] ⇒ same_request request_key retry_key &&
                   same_request retry_key transport_key &&
                   same_attempt fresh_attempt submitted_attempt &&
                   not (same_attempt old_attempt fresh_attempt)
            _ ⇒ False

all_tests : Bool
all_tests =
  native_transition_mask 0 ≟ 0 &&
  native_transition_mask 1 ≟ 420 &&
  native_transition_mask 2 ≟ 2552 &&
  native_transition_mask 3 ≟ 2524 &&
  native_transition_mask 4 ≟ 0 &&
  native_transition_mask 5 ≟ 0 &&
  native_transition_mask 6 ≟ 0 &&
  native_transition_mask 7 ≟ 0 &&
  retry_event_order_test &&
  typed_command_boundary_test &&
  two_requests_test &&
  independent_views_test &&
  completion_wins_cancellation_race_test &&
  uncertain_delivery_requires_explicit_retry_test

main : IO ()
main = do
  if not retry_event_order_test
    then putStrLn "FAIL canonical retry_requested order"
    else if all_tests
      then putStrLn "PASS fastchat idric core"
      else putStrLn "FAIL fastchat idric core"
  putStrLn ("static const unsigned canonical_admission_masks[] ← { " ++
    show (native_transition_mask 0) ++ ", " ++ show (native_transition_mask 1) ++ ", " ++
    show (native_transition_mask 2) ++ ", " ++ show (native_transition_mask 3) ++ ", " ++
    show (native_transition_mask 4) ++ ", " ++ show (native_transition_mask 5) ++ ", " ++
    show (native_transition_mask 6) ++ ", " ++ show (native_transition_mask 7) ++ " };")
