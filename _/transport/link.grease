#!/usr/bin/env grease
var root = $1
var output = $2
var ndk = $3
var platform = $4
var protocol = $5
var prefix = "$output/prefix"
var ndk_bin = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
var compiler = "$ndk_bin/clang"
if (platform === 'a1') { setvar compiler = "$ndk_bin/armv7a-linux-androideabi24-clang" }
var libraries = ["$prefix/lib/libcurl.a", "$prefix/lib/libnghttp2.a"]
if (protocol === '3') {
  setvar libraries = libraries ++ ["$prefix/lib/libngtcp2_crypto_ossl.a", "$prefix/lib/libngtcp2.a", "$prefix/lib/libnghttp3.a"]
}
var system_libraries = ['-ldl', '-pthread']
if (platform === 'host') { setvar system_libraries = system_libraries ++ ['-lm'] }
"$compiler" -std=c11 -Os -fPIC -Wall -Wextra -Werror -DCURL_STATICLIB \
  -I "$prefix/include" -I "$root/transport/native" \
  -shared -Wl,--no-undefined -Wl,--exclude-libs,ALL \
  "$root/transport/native/curl_transport.c" "$root/transport/native/sse.c" "$root/transport/native/provider_framing.c" \
  @libraries "$prefix/lib/libssl.a" "$prefix/lib/libcrypto.a" @system_libraries \
  -o "$output/libfastchat_transport.so"
"$compiler" -std=c11 -Os -Wall -Wextra -Werror -DCURL_STATICLIB \
  -I "$prefix/include" -I "$root/transport/native" \
  "$root/examples/autogenerated/http-transport/probe.c" \
  "$root/transport/native/curl_transport.c" "$root/transport/native/sse.c" "$root/transport/native/provider_framing.c" \
  @libraries "$prefix/lib/libssl.a" "$prefix/lib/libcrypto.a" @system_libraries \
  -o "$output/fastchat-transport-probe"
wc -c "$output/libfastchat_transport.so" "$output/fastchat-transport-probe" > "$output/unstripped-bytes.txt"
"$ndk_bin/llvm-strip" "$output/libfastchat_transport.so" "$output/fastchat-transport-probe"
wc -c "$output/libfastchat_transport.so" "$output/fastchat-transport-probe" > "$output/stripped-bytes.txt"
"$ndk_bin/llvm-readelf" -h -d "$output/libfastchat_transport.so" > "$output/elf.txt"
"$compiler" --version > "$output/compiler.txt"
sha256sum "$output/libfastchat_transport.so" "$output/fastchat-transport-probe" > "$output/artifacts.sha256"
echo "PASS link $platform HTTP/$protocol"
