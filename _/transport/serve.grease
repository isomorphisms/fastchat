#!/usr/bin/env grease
# Controlled host fixture for a subsequently attested physical A1 run.
var root = $1
var certificates = $2
var protocol = $3
var bind_address = $4
var subject_alt_names = $5
var port = $6
var python = $7
mkdir -p "$certificates"
openssl req -x509 -newkey rsa:2048 -nodes -keyout "$certificates/fixture-key.pem" \
  -out "$certificates/fixture-cert.pem" -days 2 -subj /CN=FastChat-fixture \
  -addext "subjectAltName=$subject_alt_names"
chmod 600 "$certificates/fixture-key.pem"
sha256sum "$certificates/fixture-cert.pem"
setglobal ENV.FC_FIXTURE_BIND = bind_address
if (protocol === '2') {
  node "$root/examples/autogenerated/http-transport/fixture-h2.js" \
    "$certificates/fixture-cert.pem" "$certificates/fixture-key.pem" "$port"
} else {
  "$python" "$root/examples/autogenerated/http-transport/fixture-h3.py" \
    "$certificates/fixture-cert.pem" "$certificates/fixture-key.pem" "$port"
}
