#!/usr/bin/env grease
var root = $1
var output = $2
var evidence = $3
var protocol = $4
var python = $5
var idric = $6
var idric_libraries = $7
var idric_support = $8
var chez = $9
var ndk = ${10}
mkdir -p "$evidence"
setglobal ENV.IDRIS2_PATH = idric_libraries
setglobal ENV.IDRIS2_DATA = idric_support
setglobal ENV.CHEZ = chez
setglobal ENV.LD_LIBRARY_PATH = output ++ ':' ++ idric_support ++ '/c'
cd "$root/examples/autogenerated/http-transport"
"$idric" --cg chez -o transport-core-test TransportCoreTest.idric > "$evidence/idric-build.txt" 2>&1
# Compiler exit zero is insufficient: this pinned compiler prints some errors
# with success status. Check actual diagnostics and the live PASS assertion.
if rg 'Error:|FAIL' "$evidence/idric-build.txt" { exit 1 }
var compiler = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
"$compiler" -std=c11 -Wall -Wextra -Werror -I "$root/transport/native" \
  framing-test.c "$root/transport/native/sse.c" "$root/transport/native/provider_framing.c" \
  -o "$output/framing-test"
"$output/framing-test" > "$evidence/framing-test.txt"
node qualify.js "$output/fastchat-transport-probe" "$protocol" "$evidence" "$python" \
  "$root/examples/autogenerated/http-transport/build/exec/transport-core-test" \
  > "$evidence/suite.txt" 2>&1
echo "PASS HTTP/$protocol host protocol and typed semantic qualification"
